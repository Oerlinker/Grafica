<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>


  <!-- Identificadores del proyecto-->
  <groupId>com.graphics</groupId>
  <artifactId>opengl-java-class</artifactId>
  <packaging>jar</packaging>
  <version>1.0-SNAPSHOT</version>


  <name>opengl-java-class</name>
  <url>http://maven.apache.org</url>

  <!--propiedades que se reutilizan en el pom
  Aqui definir la version de Java y LWJGL-->
  <properties>
    <!--Version de java para compilar -->
  <maven.compiler.source>17</maven.compiler.source>
    <!--Version del bytecode generado -->
    <maven.compiler.target>17</maven.compiler.target>
    <!--Version de LWJGL -->
    <lwjgl.version>3.3.6</lwjgl.version>
    <!--Clase que contiene el psvm -->
    <mainClass>com.graphics.App</mainClass>
  </properties>

  <!--Bibliotecas que el proyecto necesita para compilar y ejecutar -->
  <dependencies>
    <!--JUnit: Biblioteca para escribir pruebas unitarias -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>3.8.1</version>
      <scope>test</scope>
    </dependency>
    <!--
    LWJGL: Son los binding de Java para OpenGL y GLFW
    Tres modulos principales:
      - lwjgl -> Es el nucleo para la carga de la biblioteca nativa de OpenGL
      - lwjgl-glfw -> Crear ventana, teclado, raton
      - lwjgl-opengl -> Llamadas a OpenGL
     -->
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl</artifactId>
      <version>${lwjgl.version}</version>
    </dependency>
    <dependency>
    <groupId>org.lwjgl</groupId>
    <artifactId>lwjgl-glfw</artifactId>
    <version>${lwjgl.version}</version>
  </dependency>
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl-opengl</artifactId>
      <version>${lwjgl.version}</version>
    </dependency>
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl-opengl</artifactId>
      <version>${lwjgl.version}</version>
      <classifier>natives-windows</classifier>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl</artifactId>
      <version>${lwjgl.version}</version>
      <classifier>natives-windows</classifier>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.lwjgl</groupId>
      <artifactId>lwjgl-glfw</artifactId>
      <version>${lwjgl.version}</version>
      <classifier>natives-windows</classifier>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
  <!--
  BUILD = como compilar y que plugins usar
   -->
  <build>
    <plugins>
      <!--
      Aqui Forzamos java 17 para que el compilador use esa verison aunque en el sistema haya otra.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <source>17</source>
          <target>17</target>
          <release>17</release>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <configuration>
          <executable>java</executable>
          <arguments>
            <argument>-XstartOnFirstThread</argument>
            <argument>-classpath</argument>
            <argument>${mainClass}</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
